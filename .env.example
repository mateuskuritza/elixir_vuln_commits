# copie para .env e preencha. o .env não vai para o git.
# as variáveis não são lidas sozinhas: carregue antes de rodar os comandos
#   set -a; source .env; set +a

# obrigatória só para mix vuln.judge
ANTHROPIC_API_KEY=

# modelo e versão do prompt (estes são os padrões)
JUDGE_MODEL=claude-opus-5-5
PROMPT_VERSION=v2

# opcional: sem ela a ferramenta tenta `gh auth token`; sem nenhum dos dois, vai sem token (limite menor da API)
GITHUB_TOKEN=
